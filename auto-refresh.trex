<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="local.autorefresh.questionnaire" extension-version="1.0.0">
    <default-locale>fr_FR</default-locale>
    <name resource-id="name"/>
    <description>Actualise automatiquement les sources de données en connexion dynamique du tableau de bord.</description>
    <author name="Questionnaire visiteurs" email="contact@example.com" organization="" website="http://localhost:8765"/>
    <min-api-version>1.1</min-api-version>
    <source-location>
      <url>http://localhost:8765/auto-refresh.html</url>
    </source-location>
    <icon/>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <resources>
      <resource id="name">
        <text locale="fr_FR">Actualisation automatique</text>
      </resource>
    </resources>
  </dashboard-extension>
</manifest>
